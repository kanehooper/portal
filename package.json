{
  "name": "nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --experimental-strip-types scripts/generate-theme.ts && next dev",
    "build": "node --experimental-strip-types scripts/generate-theme.ts && next build",
    "worker": "tsx src/worker/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "owner": "tsx scripts/owner-account.ts",
    "backup": "tsx scripts/backup.ts",
    "theme:generate": "node --experimental-strip-types scripts/generate-theme.ts",
    "theme:check": "node --experimental-strip-types scripts/generate-theme.ts --check",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "node --experimental-strip-types scripts/check-css-contract.ts && eslint",
    "css:check": "node --experimental-strip-types scripts/check-css-contract.ts",
    "test": "vitest run",
    "test:layout": "playwright test",
    "test:layout:update": "playwright test --update-snapshots",
    "check:ui": "pnpm theme:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:layout"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-auth": "^1.7.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.9",
    "pm2": "^7.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.2"
}
